# Google Apps Script Webhook URL
# Deploy your Apps Script as a web app and paste the URL here
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Candidate Acquisition lead-capture endpoint (CA-001). Quiz submissions are piped
# here with source='quiz'. Local: http://localhost:4000/api/leads/capture
# Prod: https://<railway-backend-domain>/api/leads/capture. Leave blank to disable.
LEADS_CAPTURE_URL=http://localhost:4000/api/leads/capture
